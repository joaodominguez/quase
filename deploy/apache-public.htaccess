# Apache DocumentRoot helper for quase.pt — proxy everything to Next standalone.
# Place at /var/www/quase/public/.htaccess (DocumentRoot → /var/www/quase/public)
DirectoryIndex disabled
RewriteEngine On

RewriteCond %{HTTP_HOST} ^www\.quase\.pt$ [NC]
RewriteRule ^ https://quase.pt%{REQUEST_URI} [L,R=301]

RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteRule ^$ http://127.0.0.1:3012/ [P,L]

RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteRule ^(.+)$ http://127.0.0.1:3012/$1 [P,L,QSA]

RequestHeader set X-Forwarded-Proto "https"
